[Unit]
Description=H264 Cam native H.264 RTSP stream
After=local-fs.target network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Environment=PYTHONPATH=/opt/petcam/src
Environment=PETCAM_RUN=/run/petcam
Environment=PETCAM_CONFIG=/var/lib/petcam/stream.json
RuntimeDirectory=petcam
RuntimeDirectoryMode=0755
UMask=0022
ExecStart=/usr/local/bin/petcam --service
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillMode=control-group

[Install]
WantedBy=multi-user.target
